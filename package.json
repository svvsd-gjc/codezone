{
  "name": "code-comp",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev | pino-pretty",
    "dev-raw": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "start-db": "prisma db push",
    "test": "run-s test:unit test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test dev-raw http://localhost:3000 'bash scripts/cypress-parallel.sh'",
    "cy:run": "cypress run --browser electron"
  },
  "dependencies": {
    "@prisma/client": "4.11",
    "crypto-js": "4.1",
    "multer": "1.4",
    "next": "13.2",
    "next-auth": "4.17",
    "next-connect": "^0.13.0",
    "pino": "8.6",
    "react": "18.2",
    "react-dom": "18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.1.1",
    "@types/multer": "^1.4.7",
    "@types/react": "^18.2.14",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.14",
    "cypress": "10.0.0",
    "cypress-parallel": "^0.15.0",
    "eslint": "8.9.0",
    "eslint-config-next": "^13.4.9",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^9.4.1",
    "postcss": "^8.4.25",
    "prisma": "4.11",
    "start-server-and-test": "^3.0.2",
    "tailwindcss": "^3.3.2",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
