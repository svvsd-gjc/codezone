generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String    @unique
  password        String
  organizer       Boolean   @default(false)
  points          Int       @default(0)
  team            Int       @default(0)
  solved_problems Problem[]
}

model Problem {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String  @unique
  description   String
  difficulty    Float   @default(0.0)
  points        Int     @default(0)
  example_cases Json    @default("{}")
  test_cases    Json    @default("{}")
  accountId     String? @db.ObjectId
  Account       User?   @relation(fields: [accountId], references: [id])
}
