generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL") // if env variable cannot be found, try `npx prisma generate`
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String    @unique
  password           String
  organizer          Boolean   @default(false)
  points             Int       @default(0)
  team               Int       @default(0)
  solved_problem_ids String[]  @db.ObjectId
  solved_problems    Problem[] @relation(fields: [solved_problem_ids], references: [id])
}

model Problem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique
  description   String
  difficulty    Float    @default(0.0)
  points        Int      @default(0)
  example_cases Json     @default("{}")
  test_cases    Json     @default("{}")
  account_ids   String[] @db.ObjectId
  accounts      User[]   @relation(fields: [account_ids], references: [id])
}
